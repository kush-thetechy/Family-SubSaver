# Supabase Authentication and private account storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Keep registration disabled during private testing. Set to true only for public launch.
NEXT_PUBLIC_ALLOW_SIGN_UP=false
# Demo mode is off by default and should not be enabled in production.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# Google OAuth & Gmail Ingestion Connector
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Authorized redirect URI: http://localhost:3000/api/connectors/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required in production: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FSS_GMAIL_SESSION_SECRET=

# Server-side Gmail release gate. Disabled fails closed.
# Test mode requires an explicit comma-separated list of Supabase user UUIDs.
GMAIL_MODE=disabled
GMAIL_TESTER_USER_IDS=
# Set true only after owner-approved public-launch evidence is complete.
GMAIL_PUBLIC_LAUNCH_APPROVED=false
GMAIL_GOOGLE_VERIFICATION_CONFIRMED=false
GMAIL_SECURITY_ASSESSMENT_CONFIRMED=false
GMAIL_PRIVACY_REVIEW_CONFIRMED=false

# Inbound Email Webhook Secret (for SendGrid / Postmark / Cloudflare email forwarding)
INBOUND_EMAIL_WEBHOOK_SECRET=

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Family link (consent-scoped sharing). Keep false until supabase/migrations/20261024000100_family_link.sql is applied and tested.
NEXT_PUBLIC_ENABLE_FAMILY_LINK=false
